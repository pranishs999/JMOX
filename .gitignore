# .gitignore for JMOX project
# Python
__pycache__/
*.py[cod]
*$py.class
# C extensions
*.so
# Distribution / packaging
*.egg
*.egg-info/
.dist-info/
build/
develop-eggs/
parts/
sdist/
var/
*.log
# Installer logs
pip-log.txt
pip-delete-this-directory.txt
# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
# Jupyter Notebook
.ipynb_checkpoints
# Environments
.env
.venv/
env/
venv/
ENV/
env.bak/
# PyInstaller
*.manifest
*.spec
# MyPy
.mypy_cache/
.dmypy.json
dmypy.json
# Pyre type checker
.pyre/
# VS Code
.vscode/
# macOS
.DS_Store
# Node / frontend
node_modules/
# Vite and build output
dist/
# React
build/
# Environment files
.env*
# Local config
.idea/
# Logs
*.log
# Database migrations (if generated files should be tracked, but we keep alembic versions)
server/app/db/migrations/versions/*.pyc
# Temporary files
*.tmp
*.swp
# Secrets
*.pem
*.key
# Misc
*.sublime-workspace
*.sublime-project
