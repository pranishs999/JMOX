# .gitignore for JMOX project
# Python
__pycache__/
*.py[cod]
*$py.class
# C extensions
*.so
# Distribution / packaging
*.egg
*.egg-info/
.dist-info/
build/
develop-eggs/
parts/
sdist/
var/
*.log
# Installer logs
pip-log.txt
pip-delete-this-directory.txt
# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
# Jupyter Notebook
.ipynb_checkpoints
# Environments
.env
.venv/
env/
venv/
ENV/
env.bak/
# PyInstaller
*.manifest
*.spec
# MyPy
.mypy_cache/
.dmypy.json
dmypy.json
# Pyre type checker
.pyre/
# VS Code
.vscode/
# macOS
.DS_Store
# Node / frontend
node_modules/
# Vite and build output
dist/
# React
build/
# Environment files
.env*
# Local config
.idea/
# Logs
*.log
# Database migrations (if generated files should be tracked, but we keep alembic versions)
server/app/db/migrations/versions/*.pyc
# Temporary files
*.tmp
*.swp
# Flutter & Dart
.dart_tool/
.packages
.pub-cache/
.pub/
build/
flutter_*.png
*.iml
.flutter-plugins
.flutter-plugins-dependencies

# Android
apps/android/.gradle/
apps/android/local.properties
apps/android/app/build/

# iOS / macOS
apps/ios/Pods/
apps/ios/.symlinks/
apps/ios/Flutter/Flutter.framework
apps/ios/Flutter/Flutter.podspec
apps/macos/Pods/
apps/macos/.symlinks/
apps/macos/Flutter/ephemeral/

# Secrets
*.pem
*.key
.env
.env*.local
!.env.example

# Misc
*.tmp
*.swp
*.sublime-workspace
*.sublime-project
