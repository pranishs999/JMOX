# =============================================================================
# JMO Management System (JMOX) — Environment Variables Template
# =============================================================================
# Reference: docs/context.md §29 (Environment Configuration)
# Note: In Flutter, client-safe variables (SUPABASE_URL and SUPABASE_ANON_KEY)
# can be provided at compile-time via --dart-define or loaded securely.
# NEVER commit sensitive service role keys to git.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Supabase Client Configuration (Safe to ship in Flutter app)
# The anon key is public by design; authorization is enforced via PostgreSQL RLS.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# 2. Supabase Server-Side & Edge Functions (NEVER ship in client app)
# Used only by Supabase Edge Functions, database administration, and seed scripts.
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-ship-to-client
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# -----------------------------------------------------------------------------
# 3. Object Storage Configuration
# Supabase Storage bucket for learning materials, books, OMR scans, and exports.
# -----------------------------------------------------------------------------
SUPABASE_STORAGE_BUCKET=jmox-files

# -----------------------------------------------------------------------------
# 4. Push Notifications (Firebase Cloud Messaging - FCM)
# FCM credentials used by Edge Functions to trigger push notifications.
# Client config files (google-services.json / GoogleService-Info.plist) ship in apps/.
# -----------------------------------------------------------------------------
FCM_PROJECT_ID=your-firebase-project-id
FCM_SERVER_KEY=your-fcm-server-key

# -----------------------------------------------------------------------------
# 5. Upstash Redis (Optional / Narrow Caching & Rate Limiting)
# Used strictly for Edge Function rate limiting and caching computed ranking
# leaderboards (see docs/context.md §24). Not used for user sessions.
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# -----------------------------------------------------------------------------
# 6. Institution Scope (Development / Staging Seed)
# Used during development or single-tenant seed testing. Production is multi-institute.
# -----------------------------------------------------------------------------
DEFAULT_INSTITUTION_ID=00000000-0000-0000-0000-000000000001