# JMO Management System — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env files to git

# =============================================================================
# APPLICATION
# =============================================================================
APP_ENV=development                          # development | staging | production
APP_SECRET_KEY=your-super-secret-key-change-in-production-min-64-chars
APP_ALLOWED_ORIGINS=                       # Optional; used only for browser-based clients

# =============================================================================
# DATABASE (Supabase / PostgreSQL)
# =============================================================================
# Local development (Docker Compose)
DATABASE_URL=postgresql+asyncpg://jmox:jmox_dev_password@localhost:5432/jmox?sslmode=disable
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# Production (Supabase with Supavisor pooling)
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname?sslmode=require
# DATABASE_POOL_SIZE=20
# DATABASE_MAX_OVERFLOW=10

# =============================================================================
# REDIS (Upstash or local)
# =============================================================================
# Local development (Docker Compose)
REDIS_URL=redis://localhost:6379

# Production (Upstash)
# REDIS_URL=rediss://default:token@host:6379

# =============================================================================
# SUPABASE STORAGE
# =============================================================================
# Local development - not used, files stored locally or use Supabase local
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_KEY=your-supabase-service-key
STORAGE_BUCKET=jmox-files

# Production
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-production-service-role-key

# =============================================================================
# JWT (Flutter Client Authentication)
# =============================================================================
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production-min-64-chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# =============================================================================
# EMAIL (Resend / SendGrid / SMTP)
# =============================================================================
EMAIL_PROVIDER=console                       # console | resend | sendgrid | smtp
EMAIL_API_KEY=your-email-api-key
EMAIL_FROM=noreply@localhost

# Resend example:
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM=JMO System <noreply@yourdomain.com>

# SendGrid example:
# EMAIL_PROVIDER=sendgrid
# EMAIL_API_KEY=SG.xxxxxxxxxxxx
# EMAIL_FROM=JMO System <noreply@yourdomain.com>

# SMTP example:
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# EMAIL_FROM=JMO System <noreply@yourdomain.com>

# =============================================================================
# OMR WORKER
# =============================================================================
OMR_STORAGE_PREFIX=omr-scans/
OMR_WORKER_CONCURRENCY=2

# =============================================================================
# INSTITUTION (v1 Single-Tenant)
# =============================================================================
# Generate a UUID for your institution: python -c "import uuid; print(uuid.uuid4())"
DEFAULT_INSTITUTION_ID=00000000-0000-0000-0000-000000000001

# =============================================================================
# FLUTTER CLIENT
# =============================================================================
# Android uses --dart-define=API_BASE_URL=http://10.0.2.2:8000/api/v1
# Keep API_BASE_URL free of secrets.